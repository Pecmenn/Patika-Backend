{
  "name": "patika-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node src/server.ts",
    "test": "node --no-warnings --env-file=.env --test --test-concurrency=1 tests/*.test.ts",
    "test:page": "playwright test",
    "clinic": "node --no-warnings --env-file=.env scripts/clinics.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "kysely": "^0.29.8",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3"
  }
}
