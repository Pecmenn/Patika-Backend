# Bu dosyayı .env adıyla kopyala ve parolaları değiştir. .env Git'e girmez.
MYSQL_ROOT_PASSWORD=degistir
MYSQL_PASSWORD=degistir

# Docker dışından (test ve npm run dev) bağlanmak için. Parola MYSQL_PASSWORD ile aynı olmalı.
DATABASE_URL=mysql://patika:degistir@127.0.0.1:3307/patika
TEST_DATABASE_URL=mysql://patika:degistir@127.0.0.1:3307/patika_test

# Apple kimlik belgesinin kabul edileceği uygulamalar. Expo Go'nun kimliği yalnızca geliştirme için.
APPLE_AUDIENCES=host.exp.Exponent

# Deneme hesabıyla giriş. Yalnızca geliştirirken açık olmalı, gerçek sunucuda kapatılır.
ALLOW_DEV_LOGIN=true

# Uygulamanın tarayıcı önizlemesi başka adresten istek atar. Gerçek sunucuda boş kalır.
CORS_ORIGINS=http://localhost:8081

PORT=4000
